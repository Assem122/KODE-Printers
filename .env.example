# KODE Printer — configuration.
#
# Copy to `.env` and fill in. Every variable the application reads is listed in
# apps/server/src/config/env.ts, and anything not listed there is not read
# (INV-02). With KODE_DEBUG=false the process refuses to start on a bad value
# rather than degrading silently — §B3.3: "A silent start with a bad
# configuration is worse than no start."

# ── identity ─────────────────────────────────────────────────────────────────
PUBLIC_HOSTNAME=printers.kodesportsclub.local
PUBLIC_URL=https://printers.kodesportsclub.local
TZ=Africa/Cairo

# ── secrets ──────────────────────────────────────────────────────────────────
# Generate each independently:  openssl rand -base64 48
# Boot fails if either is a placeholder, shorter than 32 characters, or if the
# two are the same value.
JWT_SECRET=
SECRET_KEY=

# ── database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=kode_printer
POSTGRES_USER=kode
# Boot fails on a default pair such as postgres:postgres (GAP-04).
POSTGRES_PASSWORD=

# ── scan share ───────────────────────────────────────────────────────────────
# Credentials the printers use for Scan to Network Folder. Only needed when the
# `scanning` profile is running.
SCAN_SHARE_USER=scanner
SCAN_SHARE_PASSWORD=

# ── email (optional) ─────────────────────────────────────────────────────────
# An internal relay usually accepts unauthenticated mail from known hosts.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=KODE Printer <printer@kodesportsclub.local>

# ── web push (optional) ──────────────────────────────────────────────────────
# Generate once:  npx web-push generate-vapid-keys
# Without these the notification centre still works; only background push is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── site collector (only on a segmented network) ─────────────────────────────
# Leave these unset on the central server. On a collector host, set
# COLLECTOR_MODE=true and paste the key shown once when the collector was
# created in the admin UI.
# COLLECTOR_MODE=true
# COLLECTOR_UPSTREAM_URL=https://printers.kodesportsclub.local
# COLLECTOR_API_KEY=
# COLLECTOR_NAME=clubhouse

# ── deployment topology ──────────────────────────────────────────────────────
# Where the app sits relative to whatever terminates TLS. §B18.3: the app must
# never be directly reachable, and these two values are the two ways of meaning
# it. They move together — setting one without the other is a boot failure.
#
#   container  the proxy is a separate container and the app's port is not
#              published, so the app binds 0.0.0.0 to be reachable on the
#              internal network. docker/app.Dockerfile sets both of these, so
#              leave them alone for a Compose deployment.
#   loopback   the proxy shares this host (IIS, or Caddy on the metal), so the
#              app binds 127.0.0.1 and nothing else can reach it. The default.
#
# Uncomment only for a bare-metal deployment.
# DEPLOYMENT_TOPOLOGY=loopback
# BIND_HOST=127.0.0.1

# ── tuning (defaults are sensible; change only with a reason) ────────────────
# POLL_INTERVAL_MS=4000        # walk-up counter poll, before ±25% jitter
# QUEUE_CONCURRENCY=2          # the converters are the bottleneck, not the queue
# UPLOAD_MAX_BYTES=104857600   # 100 MB
# LOG_LEVEL=info
